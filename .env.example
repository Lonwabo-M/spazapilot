# Copy to .env and fill in. Leave blank to run in MOCK mode (no keys needed).

# ---- AI (either provider) -------------------------------------------------
# AI_PROVIDER=openai        # any OpenAI-compatible API (OpenAI, OpenRouter, Groq...)
# AI_PROVIDER=gemini        # Google Gemini API
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=                   # default: gpt-4o-mini (openai) / gemini-2.5-flash (gemini)
AI_BASE_URL=https://api.openai.com/v1   # only for openai-compatible providers

# ---- PayPal (sandbox) -------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Sandbox BUSINESS account email(s) that receive supplier payments
PAYPAL_DEFAULT_PAYEE_EMAIL=
# Optional per-supplier payees (JSON on one line):
# SUPPLIER_PAYEE_EMAILS={"mbekweni_cc":"sb-aaa@business.example.com","boland_wholesale":"sb-bbb@business.example.com","kasi_direct":"sb-ccc@business.example.com"}
SUPPLIER_PAYEE_EMAILS=
# Optional: a saved PayPal wallet token (or link it in-app under Guardrails > PayPal)
PAYPAL_VAULT_ID=

# PayPal does not settle in ZAR: orders are charged in USD at this rate and shown in both.
ZAR_PER_USD=18.00
PAYPAL_CURRENCY=USD

# Where PayPal sends the owner back after approving (must match how you open the app)
PUBLIC_BASE_URL=http://localhost:8000
# SPAZAPILOT_DB=./spazapilot.db
# SPAZAPILOT_FORCE_MOCK=1    # force mock mode even if keys are set
